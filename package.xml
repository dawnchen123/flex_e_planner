  <version>0.1.0</version>
  <description>Layer-aware FLEX-E frontier planner for the AEDE exploration simulator.</description>

  <maintainer email="dawn@invalid.local">dawn</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
